# CloudBrowser deployment environment example.
# Copy this file to the untracked deploy/coolify/.env, then replace every
# CHANGE_ME_* secret and review every non-secret value before rendering.
# Never commit deploy/coolify/.env or real secret values.
#
# Coolify image deployments generate these stable service secrets:
# SERVICE_PASSWORD_64_ROUTERSECRET -> CB_ROUTER_SHARED_SECRET
# SERVICE_PASSWORD_64_AGENTCTRLSECRET -> CB_AGENT_CONTROL_SHARED_SECRET
# SERVICE_PASSWORD_64_CREDENTIALCAPSECRET -> CB_CREDENTIAL_CAPABILITY_SECRET
# SERVICE_PASSWORD_64_BROKERSUBMIT -> CB_BROKER_SUBMIT_SECRET
# SERVICE_PASSWORD_64_INGESTSECRET -> CB_DOWNLOADS_INGEST_SECRET
# SERVICE_PASSWORD_64_VIEWERSECRET -> CB_VIEWER_TOKEN_SECRET
# SERVICE_PASSWORD_64_DLSECRET -> CB_DOWNLOADS_SHARED_SECRET
# SERVICE_PASSWORD_64_IDLINKSECRET -> CB_IDENTITY_LINK_SHARED_SECRET
# The source-build compose uses the corresponding CB_* assignments below.
# The custody KEK always comes from an approved secret manager; it is
# never generated by Coolify magic variables.

# Source-build compose required secrets (non-secret placeholders only).
CB_ROUTER_SHARED_SECRET=CHANGE_ME_ROUTER_SECRET_MIN_16_CHARS
CB_AGENT_CONTROL_SHARED_SECRET=CHANGE_ME_AGENT_CONTROL_SECRET_MIN_16_CHARS
CB_CREDENTIAL_CAPABILITY_SECRET=CHANGE_ME_CAPABILITY_SECRET_MIN_32_CHARS
CB_BROKER_SUBMIT_SECRET=CHANGE_ME_BROKER_SUBMIT_SECRET_MIN_16_CHARS
CB_VIEWER_TOKEN_SECRET=CHANGE_ME_VIEWER_SECRET_MIN_16_CHARS
CB_DOWNLOADS_SHARED_SECRET=CHANGE_ME_DOWNLOADS_SECRET_MIN_16_CHARS
CB_DOWNLOADS_INGEST_SECRET=CHANGE_ME_INGEST_SECRET_MIN_16_CHARS
CB_IDENTITY_LINK_SHARED_SECRET=CHANGE_ME_IDENTITY_LINK_SECRET_MIN_16_CHARS
CB_BROKER_GRANT_KEK_HEX=CHANGE_ME_64_LOWERCASE_HEX_CHARACTERS_FROM_SECRET_MANAGER
# Both Compose variants fix CB_BROKER_GRANT_DB_PATH to
# /data/state/grant-custody-v1.sqlite3.

# Required deployment and service topology.
CB_INSTANCE_ID=cloudbrowser-dev-v01
CB_RELEASE_VERSION=0.2.0-dev1
CB_SLOT_SUPERVISOR_URLS=slot-1=http://slot-supervisor:8081
CB_AGENT_CONTROL_URLS=slot-1=http://agent-control:8090
CB_PRINCIPAL_ID=principal-dev01
CB_BROWSER_ID=browser-dev01
CB_BINDING_GENERATION=generation-dev01-g1

# Required broker declaration and approved credential source.
CB_BROKER_ADAPTER=basic
CB_BROKER_SITE_ID=basic-local
CB_BROKER_ORIGIN=https://basic.local.invalid
CB_BROKER_SUCCESS_PATH=/authenticated
CB_VAULT_BASE_URL=https://vault.example.invalid

# Required identity and public-host inputs.
CB_OIDC_ISSUER=https://auth.example.invalid
CB_TINYAUTH_REALM=tinyauth.example.invalid
CB_PUBLIC_BROWSER_HOST=browser.example.invalid
CB_PUBLIC_FILES_HOST=cloudfiles2.dev01.pmo.city

# Optional production integrations.
# CB_EDGE_AUTH=traefik-forwardauth
# CB_IDENTITY_LINK_BASE_URL=http://identity-link:8091
# CB_PROFILE_ID=profile-dev01
