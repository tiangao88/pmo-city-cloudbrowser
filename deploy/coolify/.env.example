# Non-secret example values only. Secrets are injected by Coolify.
# Required secret keys (values must never be committed):
# CB_VIEWER_TOKEN_SECRET
# CB_AGENT_CONTROL_SHARED_SECRET
# CB_DOWNLOADS_SHARED_SECRET
# CB_IDENTITY_LINK_SHARED_SECRET
# Edge-auth configuration (required only when CB_EDGE_AUTH is enabled):
# CB_EDGE_AUTH=traefik-forwardauth
# CB_IDENTITY_LINK_BASE_URL=http://identity-link:8091
# CB_OIDC_ISSUER=https://auth.example.invalid
# CB_TINYAUTH_REALM=tinyauth.example.invalid
CB_INSTANCE_ID=cloudbrowser-dev-v01
CB_RELEASE_VERSION=0.2.0-dev1
CB_PUBLIC_BROWSER_HOST=browser.example.invalid
CB_PUBLIC_FILES_HOST=cloudfiles2.dev01.pmo.city
CB_ROUTER_IMAGE=ghcr.io/tiangao88/pmo-city-cloudbrowser/router:0.1.0
CB_SLOT_IMAGE=ghcr.io/tiangao88/pmo-city-cloudbrowser/slot:0.1.0
CB_BROKER_IMAGE=ghcr.io/tiangao88/pmo-city-cloudbrowser/credential-broker:0.1.0
CB_NETWORK_NAME=cloudbrowser-dev-v01
CB_VOLUME_PREFIX=cloudbrowser-dev-v01
